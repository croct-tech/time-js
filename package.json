{
  "name": "@croct/time",
  "version": "0.0.0-dev",
  "description": "Additional date-time classes that complement the standard library.",
  "license": "MIT",
  "author": {
    "name": "Croct",
    "email": "lib+time-js@croct.com",
    "url": "https://github.com/croct-tech/time-js"
  },
  "keywords": [
    "croct",
    "personalization",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./build/index.d.ts",
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.js"
    },
    "./*": {
      "import": {
        "types": "./build/*.d.ts",
        "default": "./build/*.js"
      },
      "require": {
        "types": "./build/*.d.cts",
        "default": "./build/*.cjs"
      },
      "default": "./build/*.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croct-tech/time-js.git"
  },
  "bugs": {
    "url": "https://github.com/croct-tech/time-js/issues"
  },
  "homepage": "https://github.com/croct-tech/time-js",
  "scripts": {
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' tsup.config.ts '*.mjs' 'test/*.mjs'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c jest.config.mjs --coverage",
    "test:package": "npm run build && node test/package-contract.mjs",
    "validate": "tsc --noEmit",
    "build": "tsup"
  },
  "devDependencies": {
    "@croct/eslint-plugin": "^0.8.3",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "build",
    "README.md",
    "src",
    "LICENSE"
  ]
}
